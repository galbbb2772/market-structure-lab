      "HALF",
      "SKIP"
    ],
    "thresholds": [
      1.0,
      1.5,
      2.0
    ],
    "skipped_cash": "remains cash permanently; no later backfill",
    "max_drawdown": "drawdown of contribution-adjusted time-weighted portfolio index"
  },
